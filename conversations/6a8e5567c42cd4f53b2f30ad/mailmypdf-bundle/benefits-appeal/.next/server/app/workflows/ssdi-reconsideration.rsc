18:{"metadata":[["$","title","0",{"children":"Request SSDI Reconsideration | Benefits Appeal"}],["$","meta","1",{"name":"description","content":"File a reconsideration request for a denied SSDI claim with updated medical evidence and a factual response to the denial reason."}],["$","meta","2",{"name":"keywords","content":"appeal SSDI denial,SSDI reconsideration,request reconsideration SSDI,SSDI appeal reconsideration"}],["$","meta","3",{"name":"robots","content":"index, follow"}],["$","meta","4",{"name":"application/ld+json","content":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is reconsideration for SSDI?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Reconsideration is the first appeal level where a different SSA reviewer examines your claim, along with any new evidence you submit. You can request it online, by phone, or in person.\"}},{\"@type\":\"Question\",\"name\":\"Should I submit new evidence with my reconsideration?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. New medical evidence significantly improves your chances. Submit updated records, new diagnoses, treating physician statements, and any tests conducted after the initial denial.\"}},{\"@type\":\"Question\",\"name\":\"How long does SSDI reconsideration take?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Reconsideration typically takes 3-5 months. If denied at reconsideration, you can request an administrative law judge hearing, which takes longer but has a higher approval rate.\"}}]}"}],["$","link","5",{"rel":"canonical","href":"https://benefits-appeal.pages.dev/workflows/ssdi-reconsideration"}],["$","meta","6",{"property":"og:title","content":"Request SSDI Reconsideration | Benefits Appeal"}],["$","meta","7",{"property":"og:description","content":"File a reconsideration request for a denied SSDI claim with updated medical evidence and a factual response to the denial reason."}],["$","meta","8",{"property":"og:url","content":"https://benefits-appeal.pages.dev/workflows/ssdi-reconsideration"}],["$","meta","9",{"property":"og:site_name","content":"Benefits Appeal"}],["$","meta","10",{"property":"og:type","content":"article"}],["$","meta","11",{"name":"twitter:card","content":"summary"}],["$","meta","12",{"name":"twitter:title","content":"Request SSDI Reconsideration | Benefits Appeal"}],["$","meta","13",{"name":"twitter:description","content":"File a reconsideration request for a denied SSDI claim with updated medical evidence and a factual response to the denial reason."}]],"error":null,"digest":"$undefined"}
