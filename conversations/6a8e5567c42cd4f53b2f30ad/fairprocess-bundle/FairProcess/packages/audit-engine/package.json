{
  "name": "@fairprocess/audit-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "fairprocess-audit": "./dist/cli.js"
  },
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@fairprocess/policy-engine": "workspace:*"
  },
  "scripts": {
    "build": "pnpm --filter @fairprocess/policy-engine build && tsc -b tsconfig.json --clean && tsc -b tsconfig.json --force",
    "test": "pnpm build && node --test test/**/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "audit": "pnpm build && node dist/cli.js"
  }
}
