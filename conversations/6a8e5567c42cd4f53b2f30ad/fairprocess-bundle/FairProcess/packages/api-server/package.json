{
  "name": "@fairprocess/api-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b tsconfig.json --clean && tsc -b tsconfig.json --force",
    "test": "pnpm build && node --test test/**/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "pnpm build && node dist/server.js",
    "dev": "node dist/server.js"
  },
  "dependencies": {
    "@fairprocess/audit-engine": "workspace:*",
    "@fairprocess/case-model": "workspace:*",
    "@fairprocess/database": "workspace:*",
    "@fairprocess/policy-engine": "workspace:*",
    "fastify": "^5.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^9.0.0"
  }
}
