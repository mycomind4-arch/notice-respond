{
  "name": "FairProcess - Evidence Intake & Hash Verification",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "webhook/evidence-upload",
        "responseMode": "responseNode"
      },
      "id": "webhook-trigger",
      "name": "Evidence Upload Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body;\n\nconst required = ['caseId', 'filename', 'contentType', 'sha256', 'storagePath'];\nfor (const field of required) {\n  if (!body[field]) throw new Error(`Missing required field: ${field}`);\n}\n\nreturn {\n  caseId: body.caseId,\n  filename: body.filename,\n  contentType: body.contentType,\n  sizeBytes: body.sizeBytes || 0,\n  sha256: body.sha256,\n  storagePath: body.storagePath\n};"
      },
      "id": "extract-metadata",
      "name": "Extract Metadata",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.FAIRPROCESS_API_URL }}/api/cases/{{ $json.caseId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "={{ 'Bearer ' + $env.FAIRPROCESS_API_TOKEN }}" }
          ]
        },
        "options": { "treatUnauthorizedAsError": true }
      },
      "id": "verify-case-exists",
      "name": "Verify Case Exists",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "const caseData = $json;\nconst metadata = $node['Extract Metadata'].json;\nconst duplicate = (caseData.evidence || []).find((item) => item.sha256 === metadata.sha256);\n\nreturn {\n  ...metadata,\n  isDuplicate: Boolean(duplicate),\n  duplicateDocId: duplicate?.id || null\n};"
      },
      "id": "check-duplicate",
      "name": "Check for Duplicate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            { "value1": "={{ $json.isDuplicate }}", "value2": false }
          ]
        }
      },
      "id": "if-duplicate",
      "name": "Is Duplicate?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FAIRPROCESS_API_URL }}/api/cases/{{ $json.caseId }}/evidence",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Authorization", "value": "={{ 'Bearer ' + $env.FAIRPROCESS_API_TOKEN }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { filename: $json.filename, contentType: $json.contentType, sizeBytes: $json.sizeBytes, sha256: $json.sha256, storagePath: $json.storagePath } }}"
      },
      "id": "register-evidence",
      "name": "Register Evidence",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1340, 200]
    },
    {
      "parameters": {
        "channelId": "={{ $env.EVIDENCE_CHANNEL_ID }}",
        "text": "={{ `New evidence registered for case ${$node['Extract Metadata'].json.caseId}\nFile: ${$node['Extract Metadata'].json.filename}\nSHA-256: ${$node['Extract Metadata'].json.sha256}` }}"
      },
      "id": "notify-new-evidence",
      "name": "Notify Evidence Team",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [1560, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: 'duplicate', message: 'Evidence with this hash already exists', duplicateDocId: $json.duplicateDocId } }}"
      },
      "id": "respond-duplicate",
      "name": "Respond: Duplicate",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1340, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: 'registered', evidenceId: $node['Register Evidence'].json.id } }}"
      },
      "id": "respond-registered",
      "name": "Respond: Registered",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1780, 200]
    }
  ],
  "connections": {
    "Evidence Upload Webhook": { "main": [[{ "node": "Extract Metadata", "type": "main", "index": 0 }]] },
    "Extract Metadata": { "main": [[{ "node": "Verify Case Exists", "type": "main", "index": 0 }]] },
    "Verify Case Exists": { "main": [[{ "node": "Check for Duplicate", "type": "main", "index": 0 }]] },
    "Check for Duplicate": { "main": [[{ "node": "Is Duplicate?", "type": "main", "index": 0 }]] },
    "Is Duplicate?": {
      "main": [
        [{ "node": "Register Evidence", "type": "main", "index": 0 }],
        [{ "node": "Respond: Duplicate", "type": "main", "index": 0 }]
      ]
    },
    "Register Evidence": { "main": [[{ "node": "Notify Evidence Team", "type": "main", "index": 0 }]] },
    "Notify Evidence Team": { "main": [[{ "node": "Respond: Registered", "type": "main", "index": 0 }]] }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
