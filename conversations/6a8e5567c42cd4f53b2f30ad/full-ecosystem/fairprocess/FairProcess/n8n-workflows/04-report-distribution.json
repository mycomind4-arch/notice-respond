{
  "name": "FairProcess - Authorized Report Distribution",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "webhook/report-authorized",
        "responseMode": "responseNode"
      },
      "id": "webhook-trigger",
      "name": "Authorized Report Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body;\n\nif (!body.reportId) throw new Error('reportId is required');\nif (body.distributionList && !Array.isArray(body.distributionList)) {\n  throw new Error('distributionList must be an array');\n}\n\nreturn {\n  reportId: body.reportId,\n  distributionList: body.distributionList || []\n};"
      },
      "id": "extract-info",
      "name": "Extract Distribution Info",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FAIRPROCESS_API_URL }}/api/reports/{{ $json.reportId }}/publish",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Authorization", "value": "={{ 'Bearer ' + $env.FAIRPROCESS_API_TOKEN }}" }
          ]
        }
      },
      "id": "publish-report",
      "name": "Publish Previously Authorized Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.FAIRPROCESS_API_URL }}/api/reports/{{ $node['Extract Distribution Info'].json.reportId }}/markdown",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "={{ 'Bearer ' + $env.FAIRPROCESS_API_TOKEN }}" }
          ]
        }
      },
      "id": "fetch-report-md",
      "name": "Fetch Published Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [900, 300]
    },
    {
      "parameters": {
        "conditions": {
          "array": [
            { "value1": "={{ $node['Extract Distribution Info'].json.distributionList.length }}", "value2": 0, "operation": "larger" }
          ]
        }
      },
      "id": "has-distribution",
      "name": "Has Email Recipients?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.SMTP_FROM_EMAIL }}",
        "toEmail": "={{ $node['Extract Distribution Info'].json.distributionList.join(', ') }}",
        "subject": "FairProcess Integrity Report - {{ $node['Extract Distribution Info'].json.reportId }}",
        "emailFormat": "text",
        "message": "={{ $node['Fetch Published Report'].json }}",
        "options": {}
      },
      "id": "send-email",
      "name": "Distribute via Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1340, 200]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "channelId": "={{ $env.REPORT_CHANNEL_ID }}",
        "text": "={{ `FairProcess Integrity Report Published\\n\\nReport ID: ${$node['Extract Distribution Info'].json.reportId}\\n\\n---\\n\\n${$node['Fetch Published Report'].json}` }}"
      },
      "id": "send-slack",
      "name": "Distribute via Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [1560, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: 'published', reportId: $node['Extract Distribution Info'].json.reportId, emailed: $node['Extract Distribution Info'].json.distributionList.length > 0, postedToSlack: true } }}"
      },
      "id": "respond-success",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1780, 300]
    }
  ],
  "connections": {
    "Authorized Report Webhook": { "main": [[{ "node": "Extract Distribution Info", "type": "main", "index": 0 }]] },
    "Extract Distribution Info": { "main": [[{ "node": "Publish Previously Authorized Report", "type": "main", "index": 0 }]] },
    "Publish Previously Authorized Report": { "main": [[{ "node": "Fetch Published Report", "type": "main", "index": 0 }]] },
    "Fetch Published Report": { "main": [[{ "node": "Has Email Recipients?", "type": "main", "index": 0 }]] },
    "Has Email Recipients?": {
      "main": [
        [{ "node": "Distribute via Email", "type": "main", "index": 0 }],
        [{ "node": "Distribute via Slack", "type": "main", "index": 0 }]
      ]
    },
    "Distribute via Email": { "main": [[{ "node": "Distribute via Slack", "type": "main", "index": 0 }]] },
    "Distribute via Slack": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
