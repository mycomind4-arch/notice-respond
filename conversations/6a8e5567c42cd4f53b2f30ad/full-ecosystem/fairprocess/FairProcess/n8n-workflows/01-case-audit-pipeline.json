{
  "name": "FairProcess - Automated Case Audit Pipeline",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "webhook/case-ready",
        "responseMode": "responseNode"
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "const caseId = $json.body.caseId;\nconst policyBundleId = $json.body.policyBundleId;\n\nif (!caseId) {\n  throw new Error('caseId is required in the webhook payload');\n}\n\nreturn { caseId, policyBundleId: policyBundleId || null };"
      },
      "id": "extract-payload",
      "name": "Extract Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FAIRPROCESS_API_URL }}/api/cases/{{ $json.caseId }}/audit",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Authorization", "value": "={{ 'Bearer ' + $env.FAIRPROCESS_API_TOKEN }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { policyBundleId: $json.policyBundleId } }}",
        "options": { "timeout": 60000 }
      },
      "id": "run-audit",
      "name": "Run Audit",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "const auditResult = $json;\nconst findings = auditResult.findings || 0;\nconst summary = auditResult.summary || {};\n\nconst hasIssues = summary.not_located > 0 || summary.recorded_too_early > 0;\nconst hasAwaitingTrigger = summary.awaiting_trigger > 0;\n\nreturn {\n  reportId: auditResult.reportId,\n  findingsCount: findings,\n  summary,\n  hasIssues,\n  hasAwaitingTrigger,\n  requiresHumanReview: hasIssues || hasAwaitingTrigger,\n  notificationMessage: `FairProcess audit completed for case ${$node['Extract Payload'].json.caseId}.\\n\\nReport: ${auditResult.reportId}\\nFindings: ${findings}\\nStatus breakdown: ${JSON.stringify(summary, null, 2)}`\n};"
      },
      "id": "analyze-results",
      "name": "Analyze Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.FAIRPROCESS_API_URL }}/api/reports/{{ $json.reportId }}/markdown",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "={{ 'Bearer ' + $env.FAIRPROCESS_API_TOKEN }}" }
          ]
        }
      },
      "id": "fetch-report",
      "name": "Fetch Report MD",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "channelId": "={{ $env.NOTIFICATION_CHANNEL_ID }}",
        "text": "={{ $node['Analyze Results'].json.notificationMessage }}",
        "attachments": {
          "attachments": [
            {
              "filename": "integrity-report.md",
              "content": "={{ $json }}",
              "contentType": "text/markdown"
            }
          ]
        }
      },
      "id": "notify-slack",
      "name": "Notify Reviewer (Slack)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [1340, 200],
      "conditions": {
        "boolean": [
          { "value1": "={{ $node['Analyze Results'].json.requiresHumanReview }}", "value2": true }
        ]
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: 'completed', reportId: $node['Analyze Results'].json.reportId, findings: $node['Analyze Results'].json.findingsCount, requiresHumanReview: $node['Analyze Results'].json.requiresHumanReview } }}"
      },
      "id": "webhook-response",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1340, 400]
    }
  ],
  "connections": {
    "Webhook Trigger": { "main": [[{ "node": "Extract Payload", "type": "main", "index": 0 }]] },
    "Extract Payload": { "main": [[{ "node": "Run Audit", "type": "main", "index": 0 }]] },
    "Run Audit": { "main": [[{ "node": "Analyze Results", "type": "main", "index": 0 }]] },
    "Analyze Results": { "main": [[{ "node": "Fetch Report MD", "type": "main", "index": 0 }]] },
    "Fetch Report MD": { "main": [[{ "node": "Notify Reviewer (Slack)", "type": "main", "index": 0 }, { "node": "Respond to Webhook", "type": "main", "index": 0 }]] }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
